  "by_title_pattern": {
    "^New Note$": {
      "action": "check_body",
      "notes": "Untitled — classify by body content. Most common for quick iPhone shares."
    },
    "(?i)screenshot.*\\.png$": {
      "action": "screenshot",
      "notes": "Screenshot image file shared to Notes."
    },
    "(?i)^(todo|task|remind)": {
      "action": "notion_task",
      "priority": "Medium",
      "task_type": "Average / Professional",
      "notes": "Task/reminder captures."
    },
    "(?i)^(idea|concept|brainstorm)": {
      "action": "notion_task",
      "priority": "Low",
      "task_type": "Creative / Technical",
      "notes": "Idea captures."
    },
    "(?i)(course|notes|lecture|class)": {
      "action": "obsidian_save",
      "vault_path": "500 Archive/8 Work/",
      "notes": "Educational material — archive in Work."
    },
    "(?i)(research|paper|study)": {
      "action": "obsidian_save",
      "vault_path": "400 Resources/",
      "notes": "Research references."
    },
    "(?i)on Instagram": {
      "action": "link_only",
      "notes": "Instagram share with caption as title."
    }
  },
  "content_thresholds": {
    "link_only_max_text_chars": 100,
    "screenshot_max_text_chars": 50,
    "text_rich_min_text_chars": 200,
    "title_only_max_body_chars": 50
  },
  "notion_defaults": {
    "_comment": "Set data_source_id to your own Notion Tasks database data source ID.",
    "data_source_id": "REPLACE-WITH-YOUR-NOTION-DATA-SOURCE-ID",
    "status": "Backlog",
    "priority": "Medium",
    "task_type": "Average / Professional"
  },
  "clippings_path": "Clippings/",
  "vault_root": "REPLACE-WITH-ABSOLUTE-PATH-TO-YOUR-VAULT/"
}
